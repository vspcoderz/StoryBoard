# StoryBoard environment
#
# Copy to `.env.local` for development. Never commit a filled-in copy — the gitignore already
# refuses `.env`, this file is the template.

# Realtime server host, host:port with no scheme. Public by design: it identifies a deployment,
# not a person. The share token is the secret and it travels in the socket query string.
# Leave unset to run the board standalone — it works, it is just not shared.
NEXT_PUBLIC_PARTYKIT_HOST=your-project.your-account.partykit.dev

# PartyKit server secret. Set with `npx partykit secret put <NAME> --value <value>`.
# When present, a board requires a matching token. When absent the board is open, which is only
# acceptable locally.
# STORYBOARD_TOKEN=
